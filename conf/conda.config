/*
    conf/conda.config: one environment per tool, so one tool's dependencies can't
    block another tool's version. Nextflow creates each environment on first use.
*/

conda.enabled = true
docker.enabled = false
singularity.enabled = false

process {
    withName: 'CHECK_SAMPLESHEET|COVERAGE_SUMMARY|MERGE_FUSIONS' { conda = "${projectDir}/envs/python.yml" }
    withName: 'FASTQC'         { conda = "${projectDir}/envs/fastqc.yml" }
    withName: 'FASTP'          { conda = "${projectDir}/envs/fastp.yml" }
    withName: 'STAR_ALIGN'     { conda = "${projectDir}/envs/star.yml" }
    withName: 'SAMTOOLS_INDEX' { conda = "${projectDir}/envs/samtools.yml" }
    withName: 'SEQUENCE_DICT|PANEL_TO_INTERVALS|PICARD_RNASEQMETRICS|PICARD_HSMETRICS|PICARD_INSERTSIZE' {
        conda = "${projectDir}/envs/picard.yml"
    }
    withName: 'MOSDEPTH'       { conda = "${projectDir}/envs/mosdepth.yml" }
    withName: 'RSEQC'          { conda = "${projectDir}/envs/rseqc.yml" }
    withName: 'ARRIBA'         { conda = "${projectDir}/envs/arriba.yml" }
    withName: 'STARFUSION'     { conda = "${projectDir}/envs/star-fusion.yml" }
    withName: 'FEATURECOUNTS'  { conda = "${projectDir}/envs/subread.yml" }
    withName: 'MULTIQC'        { conda = "${projectDir}/envs/multiqc.yml" }
}
