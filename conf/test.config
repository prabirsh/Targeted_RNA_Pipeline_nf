/*
    conf/test.config  —  minimal smoke-test profile.
    Point references at a small chr-subset before running:  nextflow run main.nf -profile docker,test
*/
params {
    max_cpus   = 2
    max_memory = '6.GB'
    max_time   = '2.h'

    input      = "${projectDir}/assets/samplesheet.example.csv"
    panel      = 'CT'                         // small RNA-fusion panel for testing
    star_index = '/refs/test/star_index'
    gtf        = '/refs/test/chr.gtf'
    fasta      = '/refs/test/chr.fa'
    refflat    = '/refs/test/chr.refFlat.txt'
    rrna_intervals = '/refs/test/chr.rRNA.interval_list'

    skip_fusion = true                        // CTAT lib is large; enable when ready
    skip_rseqc  = true
}
