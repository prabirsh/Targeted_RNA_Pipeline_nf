/*
    conf/test.config: end-to-end run on synthetic data.
    Create the data first with tests/data/setup.sh, then run:
      nextflow run main.nf -profile conda,test
    Set TEST_DATA_DIR to use data generated somewhere else.
*/

// Kept small enough to run on a laptop or a CI runner. Set here and not through
// params.max_*, because conf/base.config reads those before this profile applies.
process {
    resourceLimits = [cpus: 2, memory: 1.5.GB, time: 1.h]
}

params {
    test_data_dir  = System.getenv('TEST_DATA_DIR') ?: "${projectDir}/tests/data/generated"
    input          = "${params.test_data_dir}/samplesheet.csv"
    panel          = "${params.test_data_dir}/panel.bed"
    star_index     = "${params.test_data_dir}/star_index"
    gtf            = "${params.test_data_dir}/annotation.gtf"
    fasta          = "${params.test_data_dir}/genome.fa"
    refflat        = "${params.test_data_dir}/refFlat.txt"
    rrna_intervals = "${params.test_data_dir}/rRNA.interval_list"
}
