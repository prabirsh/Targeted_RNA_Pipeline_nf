/*
    conf/modules.config  —  per-process containers (biocontainers, pinned tags) and publishDir.
    Pin to image digests for production.
*/

process {

    withName: 'CHECK_SAMPLESHEET' {
        container  = 'quay.io/biocontainers/python:3.10'
        publishDir = [ path: { "${params.outdir}/pipeline_info" }, mode: params.publish_dir_mode ]
    }
    withName: 'FASTQC' {
        container  = 'quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0'
        publishDir = [ path: { "${params.outdir}/qc/fastqc" }, mode: params.publish_dir_mode ]
    }
    withName: 'FASTP' {
        container  = 'quay.io/biocontainers/fastp:0.23.4--hadf994f_2'
        publishDir = [ path: { "${params.outdir}/qc/fastp" }, mode: params.publish_dir_mode, pattern: '*.{json,html,log}' ]
    }
    withName: 'STAR_ALIGN' {
        container  = 'quay.io/biocontainers/star:2.7.11b--h43eeafb_1'
        publishDir = [ path: { "${params.outdir}/star/${meta.id}" }, mode: params.publish_dir_mode, pattern: '*.{bam,out,tab,junction}' ]
    }
    withName: 'SAMTOOLS_INDEX' {
        container  = 'quay.io/biocontainers/samtools:1.20--h50ea8bc_0'
        publishDir = [ path: { "${params.outdir}/star/${meta.id}" }, mode: params.publish_dir_mode ]
    }
    withName: 'SEQUENCE_DICT|PANEL_TO_INTERVALS|PICARD_RNASEQMETRICS|PICARD_HSMETRICS|PICARD_INSERTSIZE' {
        container  = 'quay.io/biocontainers/picard:3.1.1--hdfd78af_0'
        publishDir = [ path: { "${params.outdir}/qc/picard" }, mode: params.publish_dir_mode ]
    }
    withName: 'MOSDEPTH' {
        container  = 'quay.io/biocontainers/mosdepth:0.3.8--hd299d5a_0'
        publishDir = [ path: { "${params.outdir}/qc/coverage" }, mode: params.publish_dir_mode ]
    }
    withName: 'COVERAGE_SUMMARY' {
        container  = 'quay.io/biocontainers/python:3.10'
        publishDir = [ path: { "${params.outdir}/qc/coverage" }, mode: params.publish_dir_mode ]
    }
    withName: 'RSEQC' {
        container  = 'quay.io/biocontainers/rseqc:5.0.3--py39hf95cd2a_0'
        publishDir = [ path: { "${params.outdir}/qc/rseqc" }, mode: params.publish_dir_mode ]
    }
    withName: 'ARRIBA' {
        container  = 'quay.io/biocontainers/arriba:2.4.0--h0033a41_2'
        publishDir = [ path: { "${params.outdir}/fusion/arriba" }, mode: params.publish_dir_mode ]
    }
    withName: 'STARFUSION' {
        container  = 'docker.io/trinityctat/starfusion:1.13.0'
        publishDir = [ path: { "${params.outdir}/fusion/starfusion" }, mode: params.publish_dir_mode ]
    }
    withName: 'MERGE_FUSIONS' {
        container  = 'quay.io/biocontainers/python:3.10'
        publishDir = [ path: { "${params.outdir}/fusion/merged" }, mode: params.publish_dir_mode ]
    }
    withName: 'FEATURECOUNTS' {
        container  = 'quay.io/biocontainers/subread:2.0.6--he4a0461_2'
        publishDir = [ path: { "${params.outdir}/expression" }, mode: params.publish_dir_mode ]
    }
    withName: 'MULTIQC' {
        container  = 'quay.io/biocontainers/multiqc:1.21--pyhdfd78af_0'
        publishDir = [ path: { "${params.outdir}/multiqc" }, mode: params.publish_dir_mode ]
    }
}
