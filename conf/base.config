/*
    conf/base.config: default resource requests per process label.
    Override the ceilings with --max_cpus, --max_memory and --max_time.
*/

process {

    resourceLimits = [
        cpus:   params.max_cpus as int,
        memory: params.max_memory as nextflow.util.MemoryUnit,
        time:   params.max_time as nextflow.util.Duration,
    ]

    cpus   = { 2 * task.attempt }
    memory = { 6.GB * task.attempt }
    time   = { 4.h * task.attempt }

    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143, 247] ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    withLabel: process_low {
        cpus   = 2
        memory = { 6.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }
    withLabel: process_medium {
        cpus   = 6
        memory = { 16.GB * task.attempt }
        time   = { 6.h * task.attempt }
    }
    withLabel: process_high {
        cpus   = 12
        memory = { 36.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }
    // STAR genome loading is memory-bound.
    withLabel: process_high_memory {
        cpus   = 12
        memory = { 40.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }
}
