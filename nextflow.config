/*
========================================================================================
    nextflow.config: RNA Panel Pipeline
========================================================================================
*/

manifest {
    name            = 'rna-panel-pipeline'
    author          = 'Clinical Bioinformatics'
    description     = 'Targeted-panel RNA-seq: QC, alignment, on-target and coverage metrics, fusion detection, expression'
    version         = '1.1.0'
    nextflowVersion = '!>=24.10.0'
}

params {
    // Inputs and outputs
    input              = null
    outdir             = 'results'
    publish_dir_mode   = 'copy'
    help               = false

    // Panel target regions (BED)
    panel              = null

    // References
    star_index         = null
    gtf                = null
    fasta              = null
    dict               = null      // defaults to <fasta name>.dict beside the FASTA
    refflat            = null      // without it, CollectRnaSeqMetrics is skipped
    rrna_intervals     = null
    gene_bed           = null      // BED12 gene model; without it, RSeQC is skipped

    // Fusion references
    ctat_lib           = null      // without it, STAR-Fusion is skipped
    arriba_blacklist   = null
    arriba_known       = null
    arriba_protein     = null

    // Toggles
    skip_fusion        = false
    skip_rseqc         = false

    // Resource ceilings
    max_cpus           = 16
    max_memory         = '64.GB'
    max_time           = '24.h'

    // AWS Batch
    aws_queue          = 'rna-panel-queue'
    aws_region         = 'us-east-1'
}

includeConfig 'conf/base.config'

profiles {
    standard    { process.executor = 'local' }
    docker      { docker.enabled = true; docker.runOptions = '-u $(id -u):$(id -g)'; singularity.enabled = false; conda.enabled = false }
    singularity { singularity.enabled = true; singularity.autoMounts = true; docker.enabled = false; conda.enabled = false }
    conda       { includeConfig 'conf/conda.config' }
    slurm       { process.executor = 'slurm'; process.queue = 'normal' }
    awsbatch    { process.executor = 'awsbatch'; process.queue = params.aws_queue; aws.region = params.aws_region }
    test        { includeConfig 'conf/test.config' }
}

includeConfig 'conf/modules.config'

timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html" }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.txt" }
dag      { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/dag.html" }
