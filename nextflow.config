/*
========================================================================================
    nextflow.config  —  RNA Panel Pipeline (clinical FFPE RNA targeted panel)
========================================================================================
*/

manifest {
    name            = 'rna-panel-pipeline'
    author          = 'Clinical Bioinformatics'
    description     = 'Targeted-panel RNA-seq: QC, alignment, on-target + coverage metrics, fusion detection, expression'
    version         = '1.1.0'
    nextflowVersion = '>=23.04.0'
}

params {
    // I/O
    input              = null
    outdir             = 'results'
    publish_dir_mode   = 'copy'
    help               = false

    // Panel selection (clinical: pick which panel per run)
    panel              = null      // ST8 | CT
    panel_bed          = null      // explicit BED override
    panels             = [
        ST8: "${projectDir}/SureSelectXT_V8_Covered.bed",
        CT : "${projectDir}/Indiegene_Target_2109PD008-V1_4BaseCare_RNA_Fusion_GRCh37.bed"
    ]

    // References
    star_index         = null
    gtf                = null
    fasta              = null
    dict               = null      // built from fasta if not given
    refflat            = null
    rrna_intervals     = null
    gene_bed           = null      // BED12 gene model for RSeQC (optional)

    // Fusion references
    ctat_lib           = null
    arriba_blacklist   = null
    arriba_known       = null
    arriba_protein     = null

    // Toggles
    skip_fusion        = false
    skip_rseqc         = false
    read_length        = 150

    // Resource ceilings
    max_cpus           = 16
    max_memory         = '64.GB'
    max_time           = '24.h'
}

includeConfig 'conf/base.config'

profiles {
    standard    { process.executor = 'local' }
    docker      { docker.enabled = true; docker.runOptions = '-u $(id -u):$(id -g)'; singularity.enabled = false }
    singularity { singularity.enabled = true; singularity.autoMounts = true; docker.enabled = false }
    slurm       { process.executor = 'slurm'; process.queue = 'normal' }
    awsbatch    { process.executor = 'awsbatch'; process.queue = params.aws_queue ?: 'rna-panel-queue'; aws.region = params.aws_region ?: 'us-east-1' }
    test        { includeConfig 'conf/test.config' }
}

includeConfig 'conf/modules.config'

def trace_ts = new java.util.Date().format('yyyyMMdd_HHmmss')
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline_${trace_ts}.html" }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report_${trace_ts}.html" }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace_${trace_ts}.txt" }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag_${trace_ts}.html" }

def check_max(obj, type) {
    if (type == 'memory') {
        try { return obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1 ? params.max_memory as nextflow.util.MemoryUnit : obj }
        catch (all) { return obj }
    } else if (type == 'time') {
        try { return obj.compareTo(params.max_time as nextflow.util.Duration) == 1 ? params.max_time as nextflow.util.Duration : obj }
        catch (all) { return obj }
    } else if (type == 'cpus') {
        try { return Math.min(obj, params.max_cpus as int) }
        catch (all) { return obj }
    }
}
